# Server environment

# Public site URL (no trailing slash). Used for metadata, canonical URLs,
# sitemap.xml, robots.txt, Open Graph tags, structured data and the Payload
# admin/API server URL.
#
# Confirmed production domain: https://rajasthanestaterealtors.in
# Set this exact value in the production hosting environment:
#   NEXT_PUBLIC_SITE_URL=https://rajasthanestaterealtors.in
#
# Local development should keep the default below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection used by Payload
DATABASE_URL=

# Dev schema push safety (payload.config.ts, lib/databaseSafety.ts): `next dev`
# never pushes the schema to a non-local database. Do NOT set
# RER_ALLOW_LIVE_SCHEMA_PUSH here — only on one command line, for a reviewed
# schema step (docs/LISTINGS-ROLLOUT.md).

# Payload secret
PAYLOAD_SECRET=

# Google Places API (New) — server-side only. Used for admin Nearby Search.
# Enable Places API (New) on the Google Cloud project. Do not prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

# Supabase Storage, over its S3-compatible endpoint. All five are REQUIRED in
# production — payload.config.ts refuses to start without them, because every
# image on the site is served from this bucket. Server-side only; none of these
# may be prefixed with NEXT_PUBLIC_.
#
# Find them in Supabase: Project Settings -> Storage -> S3 connection.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional, cookieless analytics. Leave both blank and no analytics script is
# rendered at all — which is the current state, and the reason the site needs
# no cookie consent banner.
#
# Set both to enable (see components/Analytics.jsx). Use a cookieless,
# aggregate-only provider such as Plausible or a self-hosted Umami. Do NOT
# point these at Google Analytics: it sets cookies, which would require a
# consent banner and a privacy-policy rewrite.
#
#   NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#   NEXT_PUBLIC_ANALYTICS_DOMAIN=rajasthanestaterealtors.in
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
